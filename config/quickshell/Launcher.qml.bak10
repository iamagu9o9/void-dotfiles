import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import QtQuick
import QtQuick.Layouts

PanelWindow {
    id: win
    property bool isOpen: false
    property string query: ""
    property int sel: 0

    readonly property var results: {
        const all = DesktopEntries.applications.values
        const q = query.toLowerCase().trim()
        const first = []
        const rest = []
        for (let i = 0; i < all.length; i++) {
            const e = all[i]
            if (e.noDisplay) continue
            const n = e.name.toLowerCase()
            if (q === "" || n.indexOf(q) === 0) first.push(e)
            else if (n.indexOf(q) >= 0
                     || (e.genericName || "").toLowerCase().indexOf(q) >= 0
                     || (e.comment || "").toLowerCase().indexOf(q) >= 0) rest.push(e)
        }
        const by = (a, b) => a.name.localeCompare(b.name)
        first.sort(by)
        rest.sort(by)
        return first.concat(rest)
    }

    visible: isOpen || card.opacity > 0.01
    color: "transparent"
    implicitWidth: 520
    implicitHeight: 560
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.keyboardFocus: isOpen ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
    WlrLayershell.namespace: "qs-menu"

    IpcHandler {
        target: "launcher"
        function toggle(): void { win.isOpen = !win.isOpen }
        function open(): void { win.isOpen = true }
        function close(): void { win.isOpen = false }
    }
    HyprlandFocusGrab { windows: [win]; active: win.isOpen; onCleared: win.isOpen = false }

    onIsOpenChanged: {
        if (isOpen) { query = ""; input.text = ""; sel = 0; focusTimer.restart() }
    }
    Timer { id: focusTimer; interval: 40; onTriggered: input.forceActiveFocus() }

    function move(d) {
        if (results.length === 0) return
        sel = Math.max(0, Math.min(results.length - 1, sel + d))
        list.positionViewAtIndex(sel, ListView.Contain)
    }
    function run() {
        const e = results[sel]
        if (!e) return
        isOpen = false
        e.execute()
    }

    Rectangle {
        id: card
        anchors.fill: parent
        radius: 26
        color: Pal.a(Pal.bg, 0.95)
        border.width: 2
        border.color: Pal.a(Pal.accent, 0.6)
        opacity: win.isOpen ? 1 : 0
        scale: win.isOpen ? 1 : 0.96
        Behavior on opacity { NumberAnimation { duration: 180 } }
        Behavior on scale { NumberAnimation { duration: 260; easing.type: Easing.OutBack; easing.overshoot: 1.05 } }

        ColumnLayout {
            anchors.fill: parent
            anchors.margins: 14
            spacing: 10

            Rectangle {
                Layout.fillWidth: true
                implicitHeight: 46
                radius: 23
                color: Pal.a(Pal.fg, 0.08)
                border.width: 1
                border.color: Pal.a(Pal.accent, 0.35)

                Text {
                    id: glyph
                    anchors.left: parent.left
                    anchors.leftMargin: 18
                    anchors.verticalCenter: parent.verticalCenter
                    text: "\uf002"
                    color: Pal.accent
                    font.family: Config.font
                    font.pixelSize: 15
                }
                TextInput {
                    id: input
                    anchors.left: glyph.right
                    anchors.leftMargin: 12
                    anchors.right: parent.right
                    anchors.rightMargin: 18
                    anchors.verticalCenter: parent.verticalCenter
                    color: Pal.fg
                    font.family: Config.font
                    font.pixelSize: 15
                    clip: true
                    onTextChanged: { win.query = text; win.sel = 0 }
                    Keys.onUpPressed: win.move(-1)
                    Keys.onDownPressed: win.move(1)
                    Keys.onReturnPressed: win.run()
                    Keys.onEnterPressed: win.run()
                    Keys.onEscapePressed: win.isOpen = false
                    Text {
                        visible: input.text === ""
                        text: "Search"
                        color: Pal.dim
                        font.family: Config.font
                        font.pixelSize: 15
                    }
                }
            }

            ListView {
                id: list
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                spacing: 2
                model: win.results
                boundsBehavior: Flickable.StopAtBounds

                delegate: Rectangle {
                    id: row
                    required property var modelData
                    required property int index
                    width: ListView.view.width
                    height: 54
                    radius: 14
                    color: index === win.sel ? Pal.a(Pal.accent, 0.24) : "transparent"

                    Image {
                        id: ic
                        anchors.left: parent.left
                        anchors.leftMargin: 12
                        anchors.verticalCenter: parent.verticalCenter
                        width: 32
                        height: 32
                        source: Quickshell.iconPath(row.modelData.icon, true)
                        sourceSize.width: 64
                        sourceSize.height: 64
                        fillMode: Image.PreserveAspectFit
                    }
                    Column {
                        anchors.left: ic.right
                        anchors.leftMargin: 14
                        anchors.right: parent.right
                        anchors.rightMargin: 12
                        anchors.verticalCenter: parent.verticalCenter
                        spacing: 1
                        Text {
                            width: parent.width
                            text: row.modelData.name
                            elide: Text.ElideRight
                            color: Pal.fg
                            font.family: Config.font
                            font.pixelSize: 13
                            font.bold: true
                        }
                        Text {
                            width: parent.width
                            visible: text !== ""
                            text: row.modelData.comment || row.modelData.genericName || ""
                            elide: Text.ElideRight
                            color: Pal.dim
                            font.family: Config.font
                            font.pixelSize: 10
                        }
                    }
                    MouseArea {
                        anchors.fill: parent
                        hoverEnabled: true
                        onEntered: win.sel = row.index
                        onClicked: { win.sel = row.index; win.run() }
                    }
                }
            }

            Text {
                visible: win.results.length === 0
                Layout.alignment: Qt.AlignHCenter
                text: "Nothing found"
                color: Pal.dim
                font.family: Config.font
                font.pixelSize: 13
            }
            Text {
                Layout.alignment: Qt.AlignHCenter
                text: "↑ ↓ choose    Enter open    Esc close"
                color: Pal.a(Pal.dim, 0.7)
                font.family: Config.font
                font.pixelSize: 10
            }
        }
    }
}
