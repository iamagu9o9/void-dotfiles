import QtQuick

Rectangle {
    id: root
    property string label: ""
    property bool active: false
    signal clicked()

    implicitWidth: t.implicitWidth + 28
    implicitHeight: 32
    radius: 16
    color: active ? Pal.a(Pal.accent, 0.32) : (ma.containsMouse ? Pal.a(Pal.fg, 0.12) : Pal.a(Pal.fg, 0.06))
    border.width: active ? 2 : 1
    border.color: active ? Pal.accent : Pal.a(Pal.fg, 0.12)
    Behavior on color { ColorAnimation { duration: 120 } }

    Text {
        id: t
        anchors.centerIn: parent
        text: root.label
        color: root.active ? Pal.fg : Pal.dim
        font.family: Config.font
        font.pixelSize: 12
        font.bold: true
    }
    MouseArea {
        id: ma
        anchors.fill: parent
        hoverEnabled: true
        onClicked: root.clicked()
    }
}
