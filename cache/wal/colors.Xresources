! X colors.
! Generated by 'wal'
*foreground:        #e2e8f6
*background:        #0a0f1c
*.foreground:       #e2e8f6
*.background:       #0a0f1c
emacs*foreground:   #e2e8f6
emacs*background:   #0a0f1c
URxvt*foreground:   #e2e8f6
XTerm*foreground:   #e2e8f6
UXTerm*foreground:  #e2e8f6
URxvt*background:   [100]#0a0f1c
XTerm*background:   #0a0f1c
UXTerm*background:  #0a0f1c
URxvt*cursorColor:  #e2e8f6
XTerm*cursorColor:  #e2e8f6
UXTerm*cursorColor: #e2e8f6
URxvt*borderColor:  [100]#0a0f1c

! Colors 0-15.
*.color0: #0a0f1c
*color0:  #0a0f1c
*.color1: #00bee3
*color1:  #00bee3
*.color2: #4bb3ff
*color2:  #4bb3ff
*.color3: #90a8eb
*color3:  #90a8eb
*.color4: #88a6ff
*color4:  #88a6ff
*.color5: #d08de3
*color5:  #d08de3
*.color6: #b097ff
*color6:  #b097ff
*.color7: #e2e8f6
*color7:  #e2e8f6
*.color8: #9098ab
*color8:  #9098ab
*.color9: #3ad5fb
*color9:  #3ad5fb
*.color10: #84c8ff
*color10:  #84c8ff
*.color11: #a7bfff
*color11:  #a7bfff
*.color12: #a7bfff
*color12:  #a7bfff
*.color13: #e7a3fb
*color13:  #e7a3fb
*.color14: #c4b4ff
*color14:  #c4b4ff
*.color15: #e2e8f6
*color15:  #e2e8f6

! Black color that will not be affected by bold highlighting.
*.color66: #0a0f1c
*color66:  #0a0f1c

! Xclock colors.
XClock*foreground: #e2e8f6
XClock*background: #0a0f1c
XClock*majorColor:  rgba:e2/e8/f6/ff
XClock*minorColor:  rgba:e2/e8/f6/ff
XClock*hourColor:   rgba:e2/e8/f6/ff
XClock*minuteColor: rgba:e2/e8/f6/ff
XClock*secondColor: rgba:e2/e8/f6/ff

! Set depth to make transparency work.
URxvt*depth: 32
