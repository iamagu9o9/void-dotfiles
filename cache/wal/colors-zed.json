{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#0a0f1c90",
                "editor.background": "#0a0f1c90",
                "editor.foreground": "#e2e8f6",
                "text": "#e2e8f6",
                "text.muted": "#e2e8f670",
                "text.ignored": "#e2e8f640",
                "text.placeholder": "#e2e8f650",
                "ignored": "#e2e8f630",
                "element.hover": "#e2e8f630",
                "ghost_element.hover": "#00bee330",
                "ghost_element.selected": "#00bee330",
                "ghost_element.active": "#00bee360",
                "border": "#0a0f1c",
                "editor.highlighted_line.background": "#00bee310",
                "editor.active_line.background": "#00bee310",
                "panel.background": "#0a0f1c90",
                "title_bar.background": "#0a0f1c90",
                "title_bar.inactive_background": "#0a0f1c90",
                "status_bar.background": "#0a0f1c90",
                "drop_target.background": "#0a0f1c90",
                "elevated_surface.background": "#0a0f1c",
                "toolbar.background": "#0a0f1c90",
                "tab_bar.background": "#0a0f1c90",
                "tab.inactive_background": "#0a0f1c90",
                "tab.active_background": "#00bee330",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#0a0f1c",
                "scrollbar.thumb.background": "#00bee3",
                "editor.gutter.background": "#0a0f1c90",
                "terminal.background": "#0a0f1c10",
                "terminal.foreground": "#e2e8f6",
                "terminal.dim_foreground": "#e2e8f6",
                "terminal.bright_foreground": "#e2e8f6",
                "terminal.ansi.black": "#0a0f1c",
                "terminal.ansi.red": "#00bee3",
                "terminal.ansi.green": "#4bb3ff",
                "terminal.ansi.yellow": "#90a8eb",
                "terminal.ansi.blue": "#88a6ff",
                "terminal.ansi.magenta": "#d08de3",
                "terminal.ansi.cyan": "#b097ff",
                "terminal.ansi.white": "#e2e8f6",
                "terminal.ansi.bright_black": "#9098ab",
                "terminal.ansi.bright_red": "#3ad5fb",
                "terminal.ansi.bright_green": "#84c8ff",
                "terminal.ansi.bright_yellow": "#a7bfff",
                "terminal.ansi.bright_blue": "#a7bfff",
                "terminal.ansi.bright_magenta": "#e7a3fb",
                "terminal.ansi.bright_cyan": "#c4b4ff",
                "terminal.ansi.bright_white": "#e2e8f6",
                "modified": "#00bee3",
                "syntax": {
                    "attribute": {
                        "color": "#00bee3"
                    },
                    "boolean": {
                      "color": "#4bb3ff"
                    },
                    "comment": {
                      "color": "#9098ab"
                    },
                    "comment.doc": {
                      "color": "#9098ab"
                    },
                    "constant": {
                      "color": "#84c8ff"
                    },
                    "function": {
                      "color": "#c4b4ff"
                    },
                    "keyword": {
                      "color": "#88a6ff"
                    },
                    "number": {
                      "color": "#d08de3"
                    },
                    "operator": {
                      "color": "#88a6ff"
                    },
                    "string": {
                      "color": "#00bee3"
                    },
                    "variable": {
                      "color": "#4bb3ff"
                    }
                },
                "players": [
                  {
                    "cursor": "#00bee3",
                    "background": "#0a0f1c",
                    "selection": "#00bee330"
                  }
                ]
            }
        }
    ]
}
